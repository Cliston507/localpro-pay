# Copy to .env (or paste into Render > Environment). Never commit real keys.

# PayPal Sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Gemini key: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to run with fake PayPal and no AI (offline demo / tests)
LOCALPRO_MOCK=0

# Optional: your public URL, e.g. https://localpro-pay.onrender.com
PUBLIC_URL=
